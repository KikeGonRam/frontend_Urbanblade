# URL base de la API JSON de barber (Laravel), incluyendo el prefijo /api/v1.
# En producción, apuntar al dominio real del backend. Usa 127.0.0.1, NO
# "localhost" -- el navegador prueba primero la ruta IPv6 (::1) para
# "localhost", y como el puerto 8000 de Docker no escucha ahí, cada carga
# tarda varios segundos en agotar ese intento antes de caer a IPv4. Con
# 127.0.0.1 nunca se intenta esa ruta.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# Clave PUBLICABLE de Stripe (pk_...) para el cobro con tarjeta (beta),
# misma clave que STRIPE_KEY en barber/.env.
NUXT_PUBLIC_STRIPE_KEY=pk_test_...
