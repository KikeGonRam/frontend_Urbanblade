# URL base de la API JSON de barber (Laravel), incluyendo el prefijo /api/v1.
# En producción, apuntar al dominio real del backend.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Clave PUBLICABLE de Stripe (pk_...) para el cobro con tarjeta (beta),
# misma clave que STRIPE_KEY en barber/.env.
NUXT_PUBLIC_STRIPE_KEY=pk_test_...
